STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# LLM 코칭 provider: "copilot"(기본, GitHub Copilot 구독) / "anthropic" / 그 외 OpenAI 호환
LLM_PROVIDER=copilot
LLM_MODEL=gpt-4.1
# `python -m strava_coach.copilot_login` 1회 실행으로 자동 저장됨 (gho_/ghu_ 토큰)
GITHUB_COPILOT_TOKEN=
# provider=anthropic 일 때만 필요
ANTHROPIC_API_KEY=
# copilot/anthropic 외 OpenAI 호환 API(Gemini/OpenAI/OpenRouter 등) 쓸 때만
# LLM_API_BASE=
# LLM_API_KEY=

# 목표·AI계획을 GitHub state 브랜치에 저장(HF 재시작 보존)용 classic PAT.
# scope: repo. Copilot 토큰과 반드시 별개의 토큰!
GITHUB_CLASSIC_TOKEN=
# (선택) 저장 위치 재정의 — 기본값이면 생략 가능
# STATE_REPO=SangjunPark54/StravaCoach
# STATE_BRANCH=state

# (선택) 날씨 예보 위치 — 기본 서울. AI 코치가 강수 예보로 비 안 오는 날에 야외 세션 배치.
# 별도 API 키 불필요(Open-Meteo).
# WEATHER_LAT=37.5665
# WEATHER_LON=126.9780
# WEATHER_LABEL=서울
